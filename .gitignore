# ==========================================
# BioSprint Engine — Git Ignore Configuration
# ==========================================

# Dependencies
node_modules/
*/node_modules/
package-lock.json.bak

# Build and Production Artifacts
dist/
dist-ssr/
build/
.vite/
.cache/
coverage/

# Environment Variables & Sensitive Credentials
.env
.env.local
.env.*.local
.env.production
.env.development
.env.demo
server/.env
server/.env.local
server/.env.*
*.env
*.env.*
!*.env.example
!**/.env.example

# Runtime Databases & Checkpoint Files
*.db
*.db-journal
*.db-wal
*.db-shm
server/data/*.db
server/data/*.db-wal
server/data/*.db-shm
server/data/*.db-journal
!server/data/.gitkeep

# User Ingestion Uploads
server/uploads/*
!server/uploads/.gitkeep

# Logs & Debug Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and Editor Temporary Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace
