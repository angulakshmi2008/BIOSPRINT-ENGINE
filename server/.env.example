# Server Port (Render / Railway assigns PORT automatically)
PORT=5000
NODE_ENV=production

# JWT Authentication Secret (Use a strong random 32+ character string)
JWT_SECRET=your_secure_jwt_secret_change_in_production

# Relational Database File Path (SQLite WAL mode)
DB_FILE=data/biosprint.db

# Ingestion Uploads Storage Directory
UPLOADS_DIR=uploads

# Allowed Frontend Origins for CORS (e.g. your Vercel deployment URL)
CLIENT_ORIGIN=https://biosprint-engine.vercel.app

# Google OAuth 2.0 Credentials (From Google Cloud Console)
# See documentation/deployment/GOOGLE_AUTH_SETUP.md for complete instructions
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
